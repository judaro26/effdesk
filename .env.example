# Neon: the POOLED connection string of the EffDesk project (host contains -pooler)
DATABASE_URL=
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
APP_URL=https://app.effdesk.com
# mail (Resend)
RESEND_API_KEY=
MAIL_FROM=EffDesk <no-reply@effdesk.com>
# comma separated emails of the platform owner(s) who can grant licences
PLATFORM_ADMIN_EMAILS=you@example.com
# Paddle (use sandbox values until launch)
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_TEAM_MONTH=
PADDLE_PRICE_TEAM_YEAR=
PADDLE_PRICE_SUITE_MONTH=
PADDLE_PRICE_SUITE_YEAR=
PADDLE_PRICE_PRO_MONTH=
PADDLE_PRICE_PRO_YEAR=
# ticket email (see docs/EMAIL.md)
INBOUND_DOMAIN=in.effdesk.com
RESEND_WEBHOOK_SECRET=

# Microsoft Entra OAuth app for tenant-authorized Intune managed-device discovery
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
